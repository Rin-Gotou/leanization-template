{
  "name": "leanization-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:pdf": "node tools/build-paper.mjs paper",
    "build:diff": "node tools/build-paper.mjs diff",
    "build:reviews": "node tools/build-paper.mjs reviews",
    "check:paper": "npm run build:pdf && npm run build:diff",
    "revision:advance": "node tools/advance-revision.mjs",
    "annotations:create": "node tools/create-annotation-copy.mjs",
    "validate:links": "node tools/validate-links.mjs",
    "check": "lake build && npm run check:paper && npm run validate:links"
  },
  "engines": {
    "node": ">=22.13"
  }
}
